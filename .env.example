# Lantern environment (copy to .env and fill in)

# --- Switch / Mattermost ---
SWITCH_CORE_URL=http://localhost:8000
SWITCH_AGENT_API_KEY=           # from Switch Console agent registration
LANTERN_AGENT_NAME=lantern

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
LANTERN_LOCAL_MODEL=qwen2.5:7b

# --- Cloud LLM keys (all optional; leave blank to skip) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Behaviour ---
LANTERN_FORCE_OFFLINE=0         # 1 = pretend offline (for demos/tests)
LANTERN_ALLOWED_CHANNELS=       # comma-separated channel IDs; blank = all
LANTERN_APPROVER_IDS=           # comma-separated Mattermost user IDs

# --- Paths ---
LANTERN_DB_PATH=lantern.db
LANTERN_LESSONS_DIR=lessons

# --- Telemetry (Switch) ---
TELEMETRY_ENABLED=false
